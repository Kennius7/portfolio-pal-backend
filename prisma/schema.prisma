generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String      @id @default(cuid())
  email                String      @unique
  password             String
  username             String      @unique @default("portfolio-pal-user")
  fullName             String
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  portfolio            Portfolio?
  refreshToken         String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @default(now()) @updatedAt
}

model Portfolio {
  id          String   @id @default(cuid())
  slug        String   @unique
  isPublished Boolean  @default(false)
  title       String   @default("My Portfolio")
  theme       String?  @default("")
  tagline     String?  @default("Frontend Engineer with a love for Visual Design")
  greeting    String?  @default("Hello")
  bioShort    String?  @default("I am a frontend developer with over 5 years of experience.")
  bioLong     String?  @default("I am a self-taught creative developer with over 5 years of experience. I bridge the gap between complex engineering and beautiful design, working primarily with WebGL and modern frontend frameworks to create unforgettable digital experiences.")
  whatsapp    String?  @default("+2348012345678")
  email       String?  @default("johndoe@portfoliopal.com")
  avatarUrl   String?  @default("https://images.unsplash.com/photo-1534528741775-53994a69daeb")
  resumeUrl   String?  @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])

  projects    Project[]
  skills      Skill[]
}

model Project {
  id                String      @id @default(cuid())
  title             String      @default("Project Title")
  description       String      @default("This is a description for the project")
  imageUrl          String      @default("https://images.unsplash.com/photo-1534528741775-53994a69daeb")
  liveUrl           String?
  projectCreatedAt  DateTime    @default(now())
  projectEndAt      String?     @default("ongoing")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @default(now()) @updatedAt

  portfolioId       String
  portfolio         Portfolio   @relation(fields: [portfolioId], references: [id])
}

model Skill {
  id          String          @id @default(cuid())
  name        String          @default("Skill name")
  description String          @default("Skill description")
  level       Int             @default(50)
  imageUrl    String          @default("https://images.unsplash.com/photo-1534528741775-53994a69daeb")
  category    SkillCategory   @default(FRONTEND_DEVELOPMENT)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt

  portfolioId String
  portfolio   Portfolio       @relation(fields: [portfolioId], references: [id])
}



