// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`


generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  username      String   @unique @default("portfolio-pal-user")
  fullName      String
  portfolio     Portfolio?
  refreshToken  String?  // hashed refresh token
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

model Portfolio {
  id          String   @id @default(cuid())
  title       String   @default("Portfolio Title")
  theme       String?  @default("")
  published   Boolean  @default(false)
  tagline     String?  @default("Portfolio Tagline")
  greeting    String?  @default("Hello")
  bioShort    String?  @default("Short bio")
  bioLong     String?  @default("Long bio")
  whatsapp    String?  @default("Whatsapp number: eg. +2348012345678")
  email       String?  @default("My email address: eg. johndoe@portfoliopal.com")
  avatarUrl   String?  @default("https://images.unsplash.com/photo-1534528741775-53994a69daeb")
  resumeUrl   String?  @default("My resume link")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  userId      String @unique
  user        User @relation(fields: [userId], references: [id])

  projects    Project[]
  skills      Skill[]
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  liveUrl     String?
  githubUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id])
}

model Skill {
  id          String   @id @default(cuid())
  name        String
  description String
  level       Int
  imageUrl    String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id])
}

